# HubSpot
HUBSPOT_CLIENT_SECRET=your_hubspot_app_client_secret
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Weave AI Agent trigger
# After saving the trigger in Weave, copy the POST URL here.
WEAVE_TRIGGER_URL=https://your-weave-instance/triggers/trigger_1778479469663/run
# Optional — only needed if Weave requires bearer token authentication
WEAVE_API_KEY=

# Flask
FLASK_SECRET_KEY=change-me-in-production
PORT=5000
DEBUG=false

# Comma-separated HubSpot dealstage internal values that belong to the
# "Upcoming delivery Awaiting COS" view. Check your pipeline settings for exact IDs.
# Example: awaiting_cos,awaiting_refurb_gfd,6
AWAITING_COS_STAGES=awaiting_cos,awaiting_refurb_gfd,6
